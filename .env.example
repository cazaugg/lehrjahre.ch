# lehrjahre.ch deployment configuration.
# Copy to .env and fill in. Keep .env private (chmod 600).

# Public hostname Traefik serves (routing). The TLS certificate is a
# Cloudflare Origin Certificate installed as host config in /etc/ssl
# (see README, "Cloudflare").
DOMAIN=lehrjahre.ch

# Flask SECRET_KEY, at least 32 characters, e.g. `openssl rand -hex 32`.
SECRET_KEY=

# Absolute public base URL used to build links in outgoing mails.
LEHRJAHRE_PUBLIC_URL=https://lehrjahre.ch

# Outgoing mail (signup verification etc.), sent from MAIL_FROM.
# Without SMTP_HOST (development only) mail is written to MAIL_DEV_OUTBOX.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=kontakt@lehrjahre.ch

# Company self-service signup (set to 0 to disable).
SIGNUP_ENABLED=1

# How long a first-login invitation link stays valid (hours, default 168).
USER_INVITE_TTL_HOURS=168

