# lehrjahre.ch deployment configuration.
# Copy to .env and fill in. Keep .env private (chmod 600).

# Public hostname Traefik serves (certificate + routing).
DOMAIN=lehrjahre.ch

# Let's Encrypt account email (expiry/abuse notices).
ACME_EMAIL=kontakt@lehrjahre.ch

# Flask SECRET_KEY, at least 32 characters, e.g. `openssl rand -hex 32`.
SECRET_KEY=
